      "t": 8,
      "subtitle": "This is what Astra created."
    },
    {
      "t": 60,
      "subtitle": "We give those five structural groups temporary colors so their boundaries are easy to follow."
    },
    {
      "t": 95,
      "subtitle": "The angles are ninety, two hundred ten, and three hundred thirty degrees."
    },
    {
      "t": 139,
      "subtitle": "Move the test point across the circle and watch the sign change."
    },
    {
      "t": 180,
      "subtitle": "Combine the bands from all three lobes to describe the complete track."
    },
    {
      "t": 225,
      "subtitle": "A dot product tells us which side of that line a point lies on."
    },
    {
      "t": 277,
      "subtitle": "Interpolate between those values to estimate the zero crossing."
    },
    {
      "t": 322,
      "subtitle": "Rounded edges look molded, but the bevel can expand beyond the input outline."
    },
    {
      "t": 366,
      "subtitle": "Subtract the pivot from the geometry’s vertices to make their coordinates local."
    },
    {
      "t": 410,
      "subtitle": "The z coordinate selects the front or the back of the puzzle."
    },
    {
      "t": 450,
      "subtitle": "Keep the discrete puzzle state separate from the animation between positions."
    },
    {
      "t": 491,
      "subtitle": "Extrude the outlines, round the edges, and organize the parts around the correct pivots."
    }
